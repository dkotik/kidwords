<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Delete Paper Key</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script src="htmx.min.js"></script>
    <link rel="stylesheet" href="bulma.min.css">
    <style>
      :root {
        --base: #cfcfcf;
        --text: #212121;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --base: #212121;
          --text: #cfcfcf;
        }
      }

      html {
        color-scheme: dark light;
        overscroll-behavior: none;
      }

      :root:has(#theme [value="light"]:checked) {
        color-scheme: light;
        --base: #cfcfcf;
        --text: #212121;
      }

      :root:has(#theme [value="dark"]:checked) {
        color-scheme: dark;
        --base: #212121;
        --text: #cfcfcf;
      }

      body {
        color: var(--text);
         
        overscroll-behavior: none;
      }

      body > main {
        padding: 1em 2.5em;
        max-width: 36em;
        margin: 0 auto;
      }

      body {
        font-family: system-ui;
        font-size: 1.5rem;
      }
    </style>
  </head>
  <body><main>
  
    Redirecting...
  
</main></body>
</html>